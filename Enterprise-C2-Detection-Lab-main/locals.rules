# =====================================================================
# Enterprise C2 Detection Lab - Custom Suricata Rules
# Author: Cyber Security Intern
# Description: Rules to detect Sliver C2 payload delivery and mTLS beaconing.
# =====================================================================

# 1. Detect Payload Delivery (Executable download over non-standard HTTP port 8080)
alert http $HOME_NET any -> $EXTERNAL_NET 8080 (msg:"SOC ALERT - Suspicious Windows Executable Download (Possible C2 Payload)"; flow:established,to_server; content:"GET"; http_method; content:".exe"; http_uri; classtype:trojan-activity; sid:1000001; rev:1;)

# 2. Detect C2 mTLS Beaconing Activity (Continuous SYN/ESTABLISHED on Port 8888)
alert tcp $HOME_NET any -> $EXTERNAL_NET 8888 (msg:"SOC ALERT - Potential Sliver mTLS C2 Beaconing Activity Detected"; flow:established,to_server; threshold:type both, track by_src, count 3, seconds 90; classtype:command-and-control; sid:1000002; rev:1;)
